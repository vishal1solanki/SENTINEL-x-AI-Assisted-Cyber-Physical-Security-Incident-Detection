    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_rfid_cloned",
      "top": 160,
      "left": -160,
      "attrs": { "color": "orange", "label": "RFID Cloned" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_iris_auth",
      "top": 240,
      "left": -160,
      "attrs": { "color": "cyan", "label": "Iris Auth" }
