    [ "esp:GND.2", "led_green:C", "black", [ "v0" ] ],
    [ "esp:19", "led_red:A", "red", [ "v0" ] ],
    [ "esp:GND.2", "led_red:C", "black", [ "v0" ] ],
    [ "esp:21", "buzzer1:2", "yellow", [ "v0" ] ],
    [ "esp:GND.2", "buzzer1:1", "black", [ "v0" ] ]
