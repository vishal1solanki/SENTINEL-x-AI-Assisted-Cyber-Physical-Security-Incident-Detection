# SENTINEL-X Environment Configuration
DATABASE_URL=sqlite:///./sentinel_x.db
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
N8N_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/sentinel-event

# AI Configuration (Optional - Demo AI Fallback active if key is blank)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Security & Authentication
JWT_SECRET=sentinel-x-super-secret-jwt-key-change-in-production-min32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application Configuration
DEMO_MODE=true
MOBILE_API_URL=http://localhost:8000

# Telegram Bot Notification Integration (Mobile Alerts via n8n)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
